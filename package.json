{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "2.43.0",
    "ember-template-lint": "7.9.3",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "stylelint": "17.4.0"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:hbs && pnpm lint:css && pnpm lint:prettier",
    "lint:js": "eslint assets/javascripts spec --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint assets/javascripts spec --fix --no-error-on-unmatched-pattern",
    "lint:hbs": "ember-template-lint 'assets/javascripts/**/*.gjs' --no-error-on-unmatched-pattern",
    "lint:css": "stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:prettier": "prettier --check 'assets/**/*.{scss,js,gjs,hbs}' --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "prettier -w 'assets/**/*.{scss,js,gjs,hbs}' --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0"
}
